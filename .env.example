# API keys for cloud providers (only the ones you use).
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
RUST_LOG=info

# SK-03: skill cards edited on the Capabilities page are saved as commits through the Forgejo API.
# A token with write access to the two repos below (Settings > Applications); without it the page is read-only.
#KOMPANION_FORGE_TOKEN=
#KOMPANION_FORGE_URL=https://git.kreative-kompas.com
#KOMPANION_SKILLS_REPO=khyretos/kreative-kompanion        # general (skills/general/) and Kompanion (skills/) cards
#KOMPANION_SKILLS_PRIVATE_REPO=khyretos/kompas-skills-kees
#KOMPANION_SKILLS_BRANCH=main                              # the branch both repos get the commits on
