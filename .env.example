# Optional. Kompanion starts without a .env; copy this to .env only to change something.
# Every line is commented out with its default.

## Address and port
# Host port (every interface). 127.0.0.1:8080 keeps it to this computer, e.g. behind a reverse proxy.
#KOMPANION_PORT=8080
# Public address(es), comma-separated: mails link to the first https one, and a proxy that rewrites
# the Host header still passes the origin check. Not needed for a LAN IP or a proxy that keeps Host.
#KOMPANION_ORIGIN=https://kompanion.example.com
# Secure flag on the login cookie. Unset: only on requests that came in over https (works on
# http://<LAN-IP>:8080 too). true: always (set this when your proxy sends no X-Forwarded-Proto).
#KOMPANION_SECURE_COOKIES=
# Name of this server in the Machines panel (needed for tools/install-host.sh), e.g. homeserver.
#KOMPANION_MACHINE_NAME=
# Your own config file inside the container (mount it, see docker-compose.override.example.yml);
# without the file the built-in default (server/kompanion.example.toml) is used.
#KOMPANION_CONFIG=/config/kompanion.toml
#RUST_LOG=info

## API keys for cloud providers (only the ones your kompanion.toml names with api_key_env)
#ANTHROPIC_API_KEY=
#DEEPSEEK_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#OVMS_API_KEY=

## Single sign-on ([oidc] in kompanion.toml; the variable its client_secret_env names)
#OIDC_CLIENT_SECRET=

## Mail (the SMTP server is set in the app's admin settings; the password stays here)
#SMTP_PASSWORD=

## Phone push through your own ntfy (docker compose --profile push up -d); its public https address
#KOMPANION_NTFY_URL=
#KOMPANION_NTFY_PORT=127.0.0.1:8081

## Skill cards (SK-03): edits on the Capabilities page are saved as commits through the Forgejo API.
# A token with write access to the two repos below (Settings > Applications); without it the page is read-only.
#KOMPANION_FORGE_TOKEN=
#KOMPANION_FORGE_URL=https://git.kreative-kompas.com
#KOMPANION_SKILLS_REPO=khyretos/kreative-kompanion
#KOMPANION_SKILLS_PRIVATE_REPO=khyretos/kompas-skills-kees
#KOMPANION_SKILLS_BRANCH=main
# Host folder with this setup's private skill cards, mounted read-only (default: an empty volume).
#KOMPANION_SKILLS_LOCAL_DIR=

## Pull-request webhook (TEN-03, docs/forge-webhook.md): paste the same secret into Forgejo.
#FORGE_WEBHOOK_SECRET=
#FORGE_TASK_USER=

## Windshift two-way task sync (off until WINDSHIFT_URL is set)
#WINDSHIFT_URL=
#WINDSHIFT_TOKEN=

## MCP tool servers ([[mcp]] in kompanion.toml; the variables their token_env names)
#MCP_SO_TOKEN=
#MCP_DOCS_TOKEN=
#MCP_KIWIX_TOKEN=
#MCP_BLENDER_TOKEN=

## Asset library (the Assets section): the folder inside the container, mounted in the override
#ASSET_LIBRARY=/library
#GAME_REPOS=
#ASSET_AI_URL=
#ASSET_AI_MODEL=
#ASSET_EMBED_URL=
#ASSET_AI_KEY_ENV=

## Studio
# GPU-03: Kreative Studio reads and sets "Studio runs on" with this token (openssl rand -hex 32); empty: off.
#KOMPANION_STUDIO_TOKEN=
# Outputs (M6-05): a host folder, and the group that may write it.
#KOMPANION_GENERATED_DIR=
#KOMPANION_GENERATED_GID=10001
# Optional profiles: anatomy (OC sheet check), push (ntfy)
#COMPOSE_PROFILES=
#KOMPANION_ANATOMY_MODELS=./anatomy-models
#KOMPANION_POSE_MODELS=./pose-models

## GPU role switch (M6-03), with the host's kompanion-gpu-role socket mounted
#GPU_ROLE_GPU=
