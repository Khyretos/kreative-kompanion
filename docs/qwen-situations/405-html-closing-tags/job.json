[
 {
  "name": "pe2-html",
  "role": "worker/web",
  "out": "/tmp/kk-pe2/studio/public/index.html",
  "precheck": false,
  "max_tokens": 5000,
  "context": [
   "/tmp/kk-pe2/studio/test/e2e/anim.e2e.js"
  ],
  "check": "cd /tmp/kk-pe2/studio && grep -c 'id=\"anim-' public/index.html | grep -q '^2[0-9]$' && grep -q 'js/anim-library.js' public/index.html && grep -q 'css/anim.css' public/index.html",
  "prompt": "Kreative Studio web UI (STU-PE2, the Animation part of the Pose tab). Plain browser JavaScript, no modules, no libraries, no build step. Edit public/index.html. SEARCH/REPLACE edits only, change nothing else.\n1. In <head>, right after the line <link rel=\"stylesheet\" href=\"/css/pose.css\"> add <link rel=\"stylesheet\" href=\"/css/anim.css\"> (same indentation).\n2. In the Pose tab, right after the \"My poses\" block (the <div class=\"input-group\"> holding <div id=\"pose-library\" class=\"pose-library\"></div>) and before the closing </div> of #generate-form-pose, add (indent 16 spaces like the blocks around it):\n<!-- STU-PE2: key poses on a timeline, played and exported as BVH, .glb, an OpenPose sprite strip or OpenPose frames -->\n<section id=\"pose-anim\" class=\"pose-anim\" aria-labelledby=\"pose-anim-title\">\n    <h3 id=\"pose-anim-title\" class=\"group-label\">Animation</h3>\n    <div class=\"pose-chips\">\n        <button type=\"button\" class=\"chip pose-chip\" id=\"anim-walk\">Walk cycle</button>\n        <button type=\"button\" class=\"ghost-btn\" id=\"anim-new\">New clip</button>\n    </div>\n    <div id=\"anim-timeline\" class=\"anim-timeline\" role=\"group\" aria-label=\"Key poses on the timeline\"></div>\n    <div class=\"anim-time-row\">\n        <button type=\"button\" class=\"ghost-btn\" id=\"anim-play\" aria-pressed=\"false\">Play</button>\n        <input type=\"range\" id=\"anim-time\" min=\"0\" max=\"1\" step=\"any\" value=\"0\" aria-label=\"Time\">\n        <output id=\"anim-time-val\" for=\"anim-time\">0.00 s</output>\n    </div>\n    <div class=\"anim-keys\">\n        <button type=\"button\" class=\"ghost-btn\" id=\"anim-add\">Add key</button>\n        <button type=\"button\" class=\"ghost-btn\" id=\"anim-remove\" disabled>Remove key</button>\n        <label for=\"anim-ease\">Ease</label>\n        <select id=\"anim-ease\">\n            <option value=\"linear\">Linear</option>\n            <option value=\"ease-in\">Ease in</option>\n            <option value=\"ease-out\">Ease out</option>\n            <option value=\"ease-in-out\" selected>Ease in and out</option>\n            <option value=\"step\">Hold</option>\n        </select>\n    </div>\n    <div class=\"anim-settings\">\n        <div class=\"input-group\">\n            <label for=\"anim-fps\">Frames per second</label>\n            <select id=\"anim-fps\"><option value=\"8\">8</option><option value=\"12\">12</option><option value=\"24\" selected>24</option><option value=\"30\">30</option></select>\n        </div>\n        <div class=\"input-group\">\n            <label for=\"anim-length\">Length (s)</label>\n            <input type=\"number\" id=\"anim-length\" min=\"0.25\" max=\"60\" step=\"0.25\" value=\"1\">\n        </div>\n        <label class=\"check-row\"><input type=\"checkbox\" id=\"anim-loop\" checked> Loop</label>\n    </div>\n    <div class=\"anim-export\">\n        <button type=\"button\" class=\"ghost-btn\" id=\"anim-dl-bvh\">BVH</button>\n        <button type=\"button\" class=\"ghost-btn\" id=\"anim-dl-glb\">.glb</button>\n        <button type=\"button\" class=\"ghost-btn\" id=\"anim-dl-strip\">Sprite strip</button>\n        <button type=\"button\" class=\"ghost-btn\" id=\"anim-dl-frames\">OpenPose frames</button>\n        <label class=\"check-row\"><input type=\"checkbox\" id=\"anim-hands\"> Hands</label>\n    </div>\n    <div class=\"action-area anim-save\">\n        <div class=\"input-group\">\n            <label for=\"anim-name\">Clip name</label>\n            <input type=\"text\" id=\"anim-name\" maxlength=\"80\" placeholder=\"Hero walk\">\n        </div>\n        <button type=\"button\" id=\"anim-save\" class=\"primary-btn\">Save clip</button>\n        <div id=\"error-msg-anim\" role=\"alert\" class=\"error-text\"></div>\n    </div>\n    <div class=\"input-group\">\n        <span class=\"group-label\">My clips</span>\n        <div id=\"anim-library\" class=\"pose-library anim-library\"></div>\n    </div>\n</section>\n3. Right after the line <script src=\"/js/pose/depth.js\"></script> add these lines (same indentation): <script src=\"/js/pose/quat.js\"></script>, <script src=\"/js/pose/anim.js\"></script>, <script src=\"/js/pose/clips.js\"></script>. Right after <script src=\"/js/pose-library.js\"></script> add <script src=\"/js/pose-anim.js\"></script> and <script src=\"/js/anim-library.js\"></script>.\n",
  "mode": "patch"
 }
]
